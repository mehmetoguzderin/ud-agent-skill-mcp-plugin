      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string"
        },
        "request_hash": {
          "type": "string"
        },
        "workspace": {
          "type": "string"
        },
        "identity": {
          "type": "object",
          "properties": {
            "device": {
              "type": "string"
            },
            "inode": {
              "type": "string"
            }
          },
          "required": [
            "device",
            "inode"
          ]
        },
        "phase": {
          "anyOf": [
            {
              "const": "prepared"
            },
            {
              "const": "committing"
            },
            {
              "const": "completed"
            },
            {
              "const": "recovering"
            },
            {
              "const": "rolled_back"
            },
            {
              "const": "conflict"
            }
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "before": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "after": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "state": {
                "anyOf": [
                  {
                    "const": "pending"
                  },
                  {
                    "const": "writing"
                  },
                  {
                    "const": "applied"
                  }
                ]
              },
              "metadata": {
                "type": "object",
                "additionalProperties": {}
              }
            },
            "required": [
              "path",
              "before",
              "after",
              "state"
            ]
          }
        },
        "directories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "token": {
                "type": "string"
              },
              "state": {
                "anyOf": [
                  {
                    "const": "planned"
                  },
                  {
                    "const": "created"
                  },
                  {
                    "const": "released"
                  },
                  {
                    "const": "removed"
                  }
                ]
              },
              "identity": {
                "type": "object",
                "properties": {
                  "device": {
                    "type": "string"
                  },
                  "inode": {
                    "type": "string"
                  }
                },
                "required": [
                  "device",
                  "inode"
                ]
              }
            },
            "required": [
              "path",
              "token",
              "state"
            ]
          }
        },
        "message": {
          "type": "string"
        },
        "read_preconditions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          }
        }
      },
      "required": [
        "version",
        "id",
        "request_hash",
        "workspace",
        "identity",
        "phase",
        "entries"
      ]
