  "$defs": {
    "transaction": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Journal",
      "$comment": "Generated from packages/workspace/src/journal.ts#Journal; source SHA256 b2e615a2d66dcba99efaa620b764f3c7296802fc1a515394e9d44fb83b5264a0. Shape validation supplements, and never replaces, native ownership, path confinement, hashes, durable lifecycle and policy checks.",
