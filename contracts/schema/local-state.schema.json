    {
      "$ref": "#/$defs/docker_job"
    },
    {
      "$ref": "#/$defs/platform_job"
    },
    {
      "$ref": "#/$defs/podman_job"
    },
    {
      "$ref": "#/$defs/userspace_marker"
    },
    {
      "$ref": "#/$defs/userspace_repair"
    },
    {
      "$ref": "#/$defs/resource"
    }
