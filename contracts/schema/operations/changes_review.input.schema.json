{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "changes_review",
  "type": "object",
  "additionalProperties": false,
  "$defs": {},
  "properties": {
    "working_tree_path": {
      "type": "string",
      "minLength": 1
    },
    "base_revision": {
      "type": "string",
      "minLength": 1
    },
    "ud_context_path": {
      "type": "string"
    },
    "options": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "base_snapshot_path": {
              "type": "string",
              "minLength": 1
            },
            "file_paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "working_tree_path",
    "base_revision",
    "ud_context_path"
  ]
}
