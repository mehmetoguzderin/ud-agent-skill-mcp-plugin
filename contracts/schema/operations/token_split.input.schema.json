{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "token_split",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "annotation_map": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id_mapping": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "created": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sentences": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "sent_id": {
                    "type": "string"
                  },
                  "conllu": {
                    "type": "string"
                  }
                },
                "required": [
                  "sent_id",
                  "conllu"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "sent_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string"
                  },
                  "comments": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^#"
                    }
                  },
                  "rows": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "id": {
                              "type": "string",
                              "minLength": 1
                            },
                            "kind": {
                              "const": "word"
                            },
                            "form": {
                              "type": "string"
                            },
                            "lemma": {
                              "type": "string"
                            },
                            "upos": {
                              "type": "string"
                            },
                            "xpos": {
                              "type": "string"
                            },
                            "head": {
                              "type": "string"
                            },
                            "deprel": {
                              "type": "string"
                            },
                            "feats": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "object"
                                },
                                {
                                  "type": "array"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "misc": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "object"
                                },
                                {
                                  "type": "array"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "deps": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                  "head_id": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "deprel": {
                                    "type": "string",
                                    "minLength": 1
                                  }
                                },
                                "required": [
                                  "head_id",
                                  "deprel"
                                ]
                              }
                            }
                          },
                          "required": [
                            "id",
                            "kind",
                            "form",
                            "lemma",
                            "upos",
                            "xpos",
                            "head",
                            "deprel",
                            "feats",
                            "misc",
                            "deps"
                          ]
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "id": {
                              "type": "string",
                              "minLength": 1
                            },
                            "kind": {
                              "const": "empty"
                            },
                            "form": {
                              "type": "string"
                            },
                            "lemma": {
                              "type": "string"
                            },
                            "upos": {
                              "type": "string"
                            },
                            "xpos": {
                              "type": "string"
                            },
                            "feats": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "object"
                                },
                                {
                                  "type": "array"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "misc": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "object"
                                },
                                {
                                  "type": "array"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "deps": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                  "head_id": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "deprel": {
                                    "type": "string",
                                    "minLength": 1
                                  }
                                },
                                "required": [
                                  "head_id",
                                  "deprel"
                                ]
                              }
                            },
                            "after_word_id": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "id",
                            "kind",
                            "form",
                            "lemma",
                            "upos",
                            "xpos",
                            "feats",
                            "misc",
                            "deps",
                            "after_word_id"
                          ]
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "id": {
                              "type": "string",
                              "minLength": 1
                            },
                            "kind": {
                              "const": "multiword"
                            },
                            "form": {
                              "type": "string"
                            },
                            "misc": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "object"
                                },
                                {
                                  "type": "array"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "components": {
                              "type": "array",
                              "minItems": 2,
                              "uniqueItems": true,
                              "items": {
                                "type": "string",
                                "minLength": 1
                              }
                            }
                          },
                          "required": [
                            "id",
                            "kind",
                            "form",
                            "misc",
                            "components"
                          ]
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "sent_id",
                  "text",
                  "comments",
                  "rows"
                ]
              }
            ]
          }
        },
        "decisions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "basic": {
              "const": "explicit"
            },
            "enhanced": {
              "const": "explicit"
            },
            "surface": {
              "const": "explicit"
            },
            "metadata": {
              "const": "explicit"
            }
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "edit_options": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "mode": {
              "enum": [
                "preview",
                "apply"
              ]
            },
            "expected_file_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "expected_fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "expected_sentence_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "boundary_policy": {
              "anyOf": [
                {
                  "enum": [
                    "transfer_to_next",
                    "drop",
                    "preserve",
                    "move_with_sentence",
                    "copy_with_sentence"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "action": {
                      "enum": [
                        "transfer_to_next",
                        "drop",
                        "preserve",
                        "move_with_sentence",
                        "copy_with_sentence"
                      ]
                    }
                  },
                  "required": [
                    "action"
                  ]
                }
              ]
            },
            "validation_options": {
              "$ref": "#/$defs/validation_options"
            },
            "idempotency_key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "replacement_word": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "form": {
              "type": "string"
            }
          },
          "required": [
            "form"
          ]
        }
      ]
    },
    "token_ref": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tree_ref": {
              "$ref": "#/$defs/tree_ref"
            },
            "token_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                {
                  "type": "integer",
                  "minimum": 1
                }
              ]
            },
            "word_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                {
                  "type": "integer",
                  "minimum": 1
                }
              ]
            },
            "id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                {
                  "type": "integer",
                  "minimum": 1
                }
              ]
            }
          },
          "required": [
            "tree_ref"
          ],
          "anyOf": [
            {
              "required": [
                "token_id"
              ],
              "properties": {
                "token_id": {}
              }
            },
            {
              "required": [
                "word_id"
              ],
              "properties": {
                "word_id": {}
              }
            },
            {
              "required": [
                "id"
              ],
              "properties": {
                "id": {}
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "token_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                {
                  "type": "integer",
                  "minimum": 1
                }
              ]
            },
            "word_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                {
                  "type": "integer",
                  "minimum": 1
                }
              ]
            },
            "id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                {
                  "type": "integer",
                  "minimum": 1
                }
              ]
            },
            "file_path": {
              "type": "string",
              "minLength": 1
            },
            "sent_id": {
              "type": "string",
              "minLength": 1
            },
            "ordinal": {
              "type": "integer",
              "minimum": 0
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "file_path"
          ],
          "allOf": [
            {
              "anyOf": [
                {
                  "required": [
                    "sent_id"
                  ],
                  "properties": {
                    "sent_id": {}
                  }
                },
                {
                  "required": [
                    "ordinal",
                    "fingerprint"
                  ],
                  "properties": {
                    "ordinal": {},
                    "fingerprint": {}
                  }
                }
              ]
            },
            {
              "anyOf": [
                {
                  "required": [
                    "token_id"
                  ],
                  "properties": {
                    "token_id": {}
                  }
                },
                {
                  "required": [
                    "word_id"
                  ],
                  "properties": {
                    "word_id": {}
                  }
                },
                {
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {}
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "tree_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file_path": {
          "type": "string",
          "minLength": 1
        },
        "sent_id": {
          "type": "string",
          "minLength": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "file_path"
      ],
      "anyOf": [
        {
          "required": [
            "sent_id"
          ],
          "properties": {
            "sent_id": {}
          }
        },
        {
          "required": [
            "ordinal",
            "fingerprint"
          ],
          "properties": {
            "ordinal": {},
            "fingerprint": {}
          }
        }
      ]
    },
    "validation_options": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "language_code": {
              "type": "string",
              "minLength": 1
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "coref": {
              "type": "boolean"
            },
            "test_filters": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "exclude_filters": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "check_families": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "content",
                  "repository",
                  "documentation"
                ]
              }
            },
            "repository_name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "properties": {
    "working_tree_path": {
      "type": "string",
      "minLength": 1
    },
    "token_ref": {
      "$ref": "#/$defs/token_ref"
    },
    "replacement_words": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/replacement_word"
      },
      "minItems": 2
    },
    "annotation_map": {
      "$ref": "#/$defs/annotation_map"
    },
    "ud_context_path": {
      "type": "string"
    },
    "edit_options": {
      "$ref": "#/$defs/edit_options"
    }
  },
  "required": [
    "working_tree_path",
    "token_ref",
    "replacement_words",
    "annotation_map",
    "ud_context_path"
  ]
}
