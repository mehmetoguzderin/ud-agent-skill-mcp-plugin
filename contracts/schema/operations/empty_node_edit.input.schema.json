{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "empty_node_edit",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "attribute_item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "values": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "attributes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/attribute_item"
              }
            ]
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "CoNLL-U attribute text, a name/value mapping, or ordered entries. Null and empty collections clear the field; null mapping values are supported for opaque MISC flags."
    },
    "dependencies": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "head_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[1-9][0-9]*)?$"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "head": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[1-9][0-9]*)?$"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "deprel": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "head_id"
              ],
              "properties": {
                "head_id": {}
              }
            },
            {
              "required": [
                "head"
              ],
              "properties": {
                "head": {}
              }
            }
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "deprel"
              ],
              "properties": {
                "deprel": {}
              }
            },
            {
              "required": [
                "relation"
              ],
              "properties": {
                "relation": {}
              }
            }
          ]
        }
      ]
    },
    "edit_options": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "mode": {
              "enum": [
                "preview",
                "apply"
              ]
            },
            "expected_file_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "expected_fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "expected_sentence_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "boundary_policy": {
              "anyOf": [
                {
                  "enum": [
                    "transfer_to_next",
                    "drop",
                    "preserve",
                    "move_with_sentence",
                    "copy_with_sentence"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "action": {
                      "enum": [
                        "transfer_to_next",
                        "drop",
                        "preserve",
                        "move_with_sentence",
                        "copy_with_sentence"
                      ]
                    }
                  },
                  "required": [
                    "action"
                  ]
                }
              ]
            },
            "validation_options": {
              "$ref": "#/$defs/validation_options"
            },
            "idempotency_key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "empty_patch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "form": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "lemma": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "upos": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "xpos": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "feats": {
          "$ref": "#/$defs/attributes"
        },
        "misc": {
          "$ref": "#/$defs/attributes"
        },
        "deps": {
          "$ref": "#/$defs/dependencies"
        }
      },
      "minProperties": 1
    },
    "tree_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file_path": {
          "type": "string",
          "minLength": 1
        },
        "sent_id": {
          "type": "string",
          "minLength": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "file_path"
      ],
      "anyOf": [
        {
          "required": [
            "sent_id"
          ],
          "properties": {
            "sent_id": {}
          }
        },
        {
          "required": [
            "ordinal",
            "fingerprint"
          ],
          "properties": {
            "ordinal": {},
            "fingerprint": {}
          }
        }
      ]
    },
    "validation_options": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "language_code": {
              "type": "string",
              "minLength": 1
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "coref": {
              "type": "boolean"
            },
            "test_filters": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "exclude_filters": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "check_families": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "content",
                  "repository",
                  "documentation"
                ]
              }
            },
            "repository_name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "properties": {
    "working_tree_path": {
      "type": "string",
      "minLength": 1
    },
    "tree_ref": {
      "$ref": "#/$defs/tree_ref"
    },
    "empty_node_id": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.[1-9][0-9]*$"
    },
    "empty_node_patch": {
      "$ref": "#/$defs/empty_patch"
    },
    "ud_context_path": {
      "type": "string"
    },
    "edit_options": {
      "$ref": "#/$defs/edit_options"
    }
  },
  "required": [
    "working_tree_path",
    "tree_ref",
    "empty_node_id",
    "empty_node_patch",
    "ud_context_path"
  ]
}
