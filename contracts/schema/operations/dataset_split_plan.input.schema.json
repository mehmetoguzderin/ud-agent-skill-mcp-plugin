{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dataset_split_plan",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "empty_options": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "properties": {
    "working_tree_path": {
      "type": "string",
      "minLength": 1
    },
    "file_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "split_spec_path": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer"
    },
    "options": {
      "$ref": "#/$defs/empty_options"
    }
  },
  "required": [
    "working_tree_path",
    "file_paths",
    "split_spec_path",
    "seed"
  ]
}
