{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sentence_validation_report",
  "type": "object",
  "additionalProperties": false,
  "$defs": {},
  "properties": {
    "working_tree_path": {
      "type": "string",
      "minLength": 1
    },
    "sentence_conllu": {
      "type": "string"
    },
    "language_code": {
      "type": "string",
      "minLength": 1
    },
    "ud_context_path": {
      "type": "string"
    },
    "options": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "language_code": {
              "type": "string",
              "minLength": 1
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "coref": {
              "type": "boolean"
            },
            "test_filters": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "exclude_filters": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "check_families": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "content",
                  "repository",
                  "documentation"
                ]
              }
            },
            "repository_name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "working_tree_path",
    "sentence_conllu",
    "language_code",
    "ud_context_path"
  ]
}
