{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "release_plan",
  "type": "object",
  "additionalProperties": false,
  "$defs": {},
  "properties": {
    "working_tree_path": {
      "type": "string",
      "minLength": 1
    },
    "target_release": {
      "type": "string"
    },
    "previous_release_path": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "ud_context_path": {
      "type": "string"
    },
    "options": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "file_paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "language_code": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "working_tree_path",
    "target_release",
    "previous_release_path",
    "ud_context_path"
  ]
}
