{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "treebank_snapshot",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "export_options": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "output_conflict_policy": {
              "enum": [
                "error",
                "replace",
                "skip-identical"
              ]
            },
            "idempotency_key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "properties": {
    "working_tree_path": {
      "type": "string",
      "minLength": 1
    },
    "file_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "output_dir_path": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "$ref": "#/$defs/export_options"
    }
  },
  "required": [
    "working_tree_path",
    "file_paths",
    "output_dir_path"
  ]
}
