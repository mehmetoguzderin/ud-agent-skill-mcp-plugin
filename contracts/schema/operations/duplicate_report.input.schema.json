{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "duplicate_report",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "matching_options": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "casefold": {
              "type": "boolean"
            },
            "normalize_whitespace": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "properties": {
    "working_tree_path": {
      "type": "string",
      "minLength": 1
    },
    "file_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "matching_options": {
      "$ref": "#/$defs/matching_options"
    }
  },
  "required": [
    "working_tree_path",
    "file_paths"
  ]
}
