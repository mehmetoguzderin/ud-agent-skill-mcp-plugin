{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "check_ud_environment",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "working_tree_path": {
      "type": "string",
      "minLength": 1
    },
    "required_tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "engine": {
      "enum": [
        "auto",
        "apple-container",
        "wslc",
        "lima-nerdctl",
        "podman",
        "docker-rootless",
        "docker",
        "userspace"
      ]
    },
    "offline": {
      "type": "boolean"
    }
  }
}
