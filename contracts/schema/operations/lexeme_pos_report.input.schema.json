{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lexeme_pos_report",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "empty_options": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        {
          "type": "null"
        }
      ]
    },
    "lexeme_filter": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lemma": {
              "type": "string"
            },
            "upos": {
              "type": "string"
            },
            "form": {
              "type": "string"
            },
            "xpos": {
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "properties": {
    "working_tree_path": {
      "type": "string",
      "minLength": 1
    },
    "lexeme_filter": {
      "$ref": "#/$defs/lexeme_filter"
    },
    "ud_context_path": {
      "type": "string"
    },
    "options": {
      "$ref": "#/$defs/empty_options"
    }
  },
  "required": [
    "working_tree_path",
    "lexeme_filter",
    "ud_context_path"
  ]
}
