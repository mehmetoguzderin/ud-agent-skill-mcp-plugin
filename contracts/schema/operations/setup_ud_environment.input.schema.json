{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "setup_ud_environment",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "working_tree_path": {
      "type": "string",
      "minLength": 1
    },
    "required_tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "engine": {
      "enum": [
        "auto",
        "apple-container",
        "wslc",
        "lima-nerdctl",
        "podman",
        "docker-rootless",
        "docker",
        "userspace"
      ]
    },
    "mode": {
      "enum": [
        "ensure",
        "repair",
        "update",
        "resume"
      ]
    },
    "network": {
      "enum": [
        "bootstrap_only",
        "offline"
      ]
    },
    "dry_run": {
      "type": "boolean"
    },
    "continuation_token": {
      "type": "string",
      "minLength": 1
    },
    "target_release": {
      "type": "string",
      "minLength": 1
    }
  }
}
