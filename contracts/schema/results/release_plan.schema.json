{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "release_plan result",
  "type": "object",
  "required": [
    "schema_version",
    "operation",
    "operation_id",
    "execution",
    "scope",
    "inputs",
    "provenance",
    "result",
    "diagnostics",
    "artifacts",
    "coverage",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "operation": {
      "const": "release_plan"
    },
    "operation_id": {
      "const": "092"
    },
    "execution": {
      "type": "object",
      "required": [
        "status",
        "elapsed_ms"
      ],
      "properties": {
        "status": {
          "enum": [
            "completed",
            "rejected",
            "incomplete"
          ]
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "scope": {
      "type": "object"
    },
    "inputs": {
      "type": "object"
    },
    "provenance": {
      "type": "object",
      "required": [
        "product_version"
      ],
      "properties": {
        "product_version": {
          "const": "0.1.0-beta.1"
        }
      }
    },
    "result": {
      "type": "object"
    },
    "diagnostics": {
      "type": "array"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "uri",
          "mime_type",
          "size_bytes",
          "sha256",
          "retention"
        ],
        "properties": {
          "uri": {
            "type": "string",
            "pattern": "^ud://"
          },
          "mime_type": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "retention": {
            "type": "object",
            "required": [
              "expires_at"
            ],
            "properties": {
              "expires_at": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "manifest_entry": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ]
    },
    "portable_release_provenance": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "selected_files_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_identity_method": {
          "type": "string"
        },
        "implementation": {
          "type": "object",
          "properties": {
            "name": {
              "const": "ud-agent-skill-mcp-plugin"
            },
            "version": {
              "const": "0.1.0-beta.1"
            },
            "new_code_license": {
              "const": "MIT"
            },
            "source": {
              "type": "object",
              "properties": {
                "files": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/manifest_entry"
                  }
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "files",
                "sha256"
              ]
            }
          },
          "required": [
            "name",
            "version",
            "new_code_license",
            "source"
          ]
        },
        "validator": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "const": "identified"
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "files": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/manifest_entry"
                      }
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "files",
                    "sha256"
                  ]
                }
              },
              "required": [
                "status",
                "source"
              ]
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "const": "unavailable"
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "status",
                "reason"
              ]
            }
          ]
        },
        "upstream_revision_declarations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "repository": {
                "type": "string"
              },
              "commit": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$"
              },
              "archive_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "evidence": {
                "type": "string"
              }
            },
            "required": [
              "repository",
              "commit",
              "evidence"
            ]
          }
        },
        "context": {
          "type": "object",
          "properties": {
            "identity": {
              "type": "string",
              "pattern": "^urn:ud-agent:context:sha256:[a-f0-9]{64}$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "rules": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "items": {
                "$ref": "#/$defs/manifest_entry"
              }
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "identity",
            "sha256",
            "rules"
          ]
        },
        "licenses": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "present",
                "not_selected"
              ]
            },
            "files": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/manifest_entry"
              }
            },
            "interpretation": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "files",
            "interpretation"
          ]
        }
      },
      "required": [
        "schema_version",
        "selected_files_sha256",
        "source_identity_method",
        "implementation",
        "validator",
        "upstream_revision_declarations",
        "context",
        "licenses"
      ]
    },
    "release_validation": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "completed",
            "incomplete"
          ]
        },
        "passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "report": {
          "$ref": "#/$defs/validation"
        }
      },
      "required": [
        "status",
        "passed"
      ]
    },
    "validation": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "incidents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "testid": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "level": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "check_family": {
                "type": "string"
              }
            },
            "required": []
          }
        },
        "scope": {
          "type": "object",
          "properties": {
            "file_paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sentence_only": {
              "type": "boolean"
            },
            "filtered": {
              "type": "boolean"
            }
          },
          "required": [
            "file_paths",
            "sentence_only"
          ]
        },
        "coverage": {
          "type": "object",
          "properties": {
            "content": {
              "type": "string"
            },
            "repository": {
              "type": "string"
            },
            "documentation": {
              "type": "string"
            },
            "project_rules": {
              "type": "string"
            },
            "release_policy": {
              "type": "string"
            }
          },
          "required": [
            "content"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provenance": {
          "type": "object",
          "properties": {
            "repository_name": {
              "type": "string"
            },
            "adapter": {
              "type": "string"
            },
            "languages_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "validator_module_path": {
              "type": "string"
            },
            "validator_class_name": {
              "type": "string"
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": []
        }
      },
      "required": [
        "passed",
        "incidents",
        "scope",
        "coverage",
        "limitations"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution": {
            "type": "object",
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "execution"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "schema_version": {
                    "const": "1"
                  },
                  "target_release": {
                    "type": "string"
                  },
                  "files": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/manifest_entry"
                    }
                  },
                  "previous_release": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          }
                        },
                        "required": [
                          "path",
                          "sha256"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "language_code": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "validation": {
                    "$ref": "#/$defs/release_validation"
                  },
                  "status": {
                    "enum": [
                      "complete",
                      "incomplete"
                    ]
                  },
                  "ready": {
                    "type": "boolean"
                  },
                  "external_requirements": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "limitations": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "provenance": {
                    "$ref": "#/$defs/portable_release_provenance"
                  },
                  "context": {
                    "type": "string"
                  }
                },
                "required": [
                  "schema_version",
                  "target_release",
                  "files",
                  "previous_release",
                  "language_code",
                  "validation",
                  "status",
                  "ready",
                  "external_requirements",
                  "limitations"
                ]
              },
              {
                "type": "object",
                "required": [
                  "status",
                  "report_resource",
                  "summary"
                ],
                "properties": {
                  "status": {
                    "const": "resource"
                  },
                  "report_resource": {
                    "type": "object",
                    "required": [
                      "uri",
                      "mime_type",
                      "size_bytes",
                      "sha256",
                      "retention"
                    ],
                    "properties": {
                      "uri": {
                        "type": "string",
                        "pattern": "^ud://"
                      },
                      "mime_type": {
                        "type": "string"
                      },
                      "size_bytes": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "retention": {
                        "type": "object",
                        "required": [
                          "expires_at"
                        ],
                        "properties": {
                          "expires_at": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "summary": {
                    "type": "object"
                  }
                }
              }
            ],
            "allOf": [
              {
                "if": {
                  "type": "object",
                  "required": [
                    "requires_host_export"
                  ],
                  "properties": {
                    "requires_host_export": {
                      "const": false
                    }
                  }
                },
                "then": {
                  "type": "object",
                  "required": [
                    "exports",
                    "export_transaction"
                  ],
                  "properties": {
                    "exports": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "path",
                          "sha256",
                          "size_bytes"
                        ],
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          },
                          "size_bytes": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      }
                    },
                    "export_transaction": {
                      "type": "object",
                      "required": [
                        "status"
                      ],
                      "properties": {
                        "status": {
                          "const": "completed"
                        }
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "type": "object",
                  "required": [
                    "requires_broker_export"
                  ],
                  "properties": {
                    "requires_broker_export": {
                      "const": false
                    }
                  }
                },
                "then": {
                  "type": "object",
                  "required": [
                    "exports",
                    "export_transaction"
                  ],
                  "properties": {
                    "exports": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "path",
                          "sha256",
                          "size_bytes"
                        ],
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          },
                          "size_bytes": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      }
                    },
                    "export_transaction": {
                      "type": "object",
                      "required": [
                        "status"
                      ],
                      "properties": {
                        "status": {
                          "const": "completed"
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
