{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "predictions_evaluate result",
  "type": "object",
  "required": [
    "schema_version",
    "operation",
    "operation_id",
    "execution",
    "scope",
    "inputs",
    "provenance",
    "result",
    "diagnostics",
    "artifacts",
    "coverage",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "operation": {
      "const": "predictions_evaluate"
    },
    "operation_id": {
      "const": "081"
    },
    "execution": {
      "type": "object",
      "required": [
        "status",
        "elapsed_ms"
      ],
      "properties": {
        "status": {
          "enum": [
            "completed",
            "rejected",
            "incomplete"
          ]
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "scope": {
      "type": "object"
    },
    "inputs": {
      "type": "object"
    },
    "provenance": {
      "type": "object",
      "required": [
        "product_version"
      ],
      "properties": {
        "product_version": {
          "const": "0.1.0-beta.1"
        }
      }
    },
    "result": {
      "type": "object"
    },
    "diagnostics": {
      "type": "array"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "uri",
          "mime_type",
          "size_bytes",
          "sha256",
          "retention"
        ],
        "properties": {
          "uri": {
            "type": "string",
            "pattern": "^ud://"
          },
          "mime_type": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "retention": {
            "type": "object",
            "required": [
              "expires_at"
            ],
            "properties": {
              "expires_at": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "properties": {
        "correct": {
          "type": "integer",
          "minimum": 0
        },
        "gold_total": {
          "type": "integer",
          "minimum": 0
        },
        "system_total": {
          "type": "integer",
          "minimum": 0
        },
        "aligned_total": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "precision": {
          "type": "number"
        },
        "recall": {
          "type": "number"
        },
        "f1": {
          "type": "number"
        },
        "aligned_accuracy": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "correct",
        "gold_total",
        "system_total",
        "aligned_total",
        "precision",
        "recall",
        "f1",
        "aligned_accuracy"
      ]
    },
    "scoring": {
      "type": "object",
      "properties": {
        "scores": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/metric"
          }
        },
        "pair_count": {
          "type": "integer",
          "minimum": 0
        },
        "enhanced": {
          "type": "boolean"
        },
        "treebank_type": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "definition": {
          "type": "string"
        },
        "roles": {
          "type": "object",
          "properties": {
            "gold": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "system": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          },
          "required": [
            "gold",
            "system"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "scores",
        "pair_count",
        "enhanced",
        "treebank_type",
        "definition",
        "roles"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution": {
            "type": "object",
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "execution"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "anyOf": [
              {
                "$ref": "#/$defs/scoring"
              },
              {
                "type": "object",
                "required": [
                  "status",
                  "report_resource",
                  "summary"
                ],
                "properties": {
                  "status": {
                    "const": "resource"
                  },
                  "report_resource": {
                    "type": "object",
                    "required": [
                      "uri",
                      "mime_type",
                      "size_bytes",
                      "sha256",
                      "retention"
                    ],
                    "properties": {
                      "uri": {
                        "type": "string",
                        "pattern": "^ud://"
                      },
                      "mime_type": {
                        "type": "string"
                      },
                      "size_bytes": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "retention": {
                        "type": "object",
                        "required": [
                          "expires_at"
                        ],
                        "properties": {
                          "expires_at": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "summary": {
                    "type": "object"
                  }
                }
              }
            ],
            "allOf": [
              {
                "if": {
                  "type": "object",
                  "required": [
                    "requires_host_export"
                  ],
                  "properties": {
                    "requires_host_export": {
                      "const": false
                    }
                  }
                },
                "then": {
                  "type": "object",
                  "required": [
                    "exports",
                    "export_transaction"
                  ],
                  "properties": {
                    "exports": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "path",
                          "sha256",
                          "size_bytes"
                        ],
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          },
                          "size_bytes": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      }
                    },
                    "export_transaction": {
                      "type": "object",
                      "required": [
                        "status"
                      ],
                      "properties": {
                        "status": {
                          "const": "completed"
                        }
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "type": "object",
                  "required": [
                    "requires_broker_export"
                  ],
                  "properties": {
                    "requires_broker_export": {
                      "const": false
                    }
                  }
                },
                "then": {
                  "type": "object",
                  "required": [
                    "exports",
                    "export_transaction"
                  ],
                  "properties": {
                    "exports": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "path",
                          "sha256",
                          "size_bytes"
                        ],
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          },
                          "size_bytes": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      }
                    },
                    "export_transaction": {
                      "type": "object",
                      "required": [
                        "status"
                      ],
                      "properties": {
                        "status": {
                          "const": "completed"
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
