{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mehmetoguzderin/ud-agent-skill-mcp-plugin/schema/evidence-v1.json",
  "title": "Signed release test evidence",
  "type": "object",
  "required": [
    "suite_id",
    "verdict",
    "executed",
    "skipped",
    "errors",
    "tests",
    "source_tree_sha256",
    "test_inventory_sha256",
    "artifact_set_sha256",
    "runtime_lock_sha256"
  ],
  "properties": {
    "suite_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "verdict": {
      "const": "passed"
    },
    "executed": {
      "type": "integer",
      "minimum": 1
    },
    "skipped": {
      "const": 0
    },
    "errors": {
      "const": 0
    },
    "source_tree_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "test_inventory_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "artifact_set_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "runtime_lock_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "source": {
            "type": "string",
            "pattern": "^(tests/|packages/[^/]+/(tests|src)/.*\\.rs$|scripts/(quality|release)/[^/]+\\.(mjs|py)$)"
          },
          "status": {
            "const": "passed"
          }
        }
      }
    },
    "survivors": {
      "const": 0
    },
    "uncovered": {
      "const": 0
    },
    "timeouts": {
      "const": 0
    },
    "invalid": {
      "const": 0
    },
    "missing": {
      "const": 0
    },
    "killed": {
      "type": "integer",
      "minimum": 1
    },
    "scheduled": {
      "type": "integer",
      "minimum": 1
    },
    "mutants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "file",
          "source_sha256",
          "definition_sha256",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "file": {
            "type": "string"
          },
          "source_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "definition_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "status": {
            "enum": [
              "killed",
              "equivalent"
            ]
          },
          "failure_kind": {
            "const": "assertion"
          },
          "killed_by": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "equivalent_exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "file",
          "source_sha256",
          "author",
          "reviewer",
          "reason",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string"
          },
          "source_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 40
          },
          "evidence": {
            "type": "object",
            "required": [
              "path",
              "sha256",
              "size",
              "signature"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "signature": {
                "type": "object",
                "required": [
                  "key_id",
                  "signature"
                ],
                "properties": {
                  "key_id": {
                    "type": "string"
                  },
                  "signature": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "suite_id": {
            "type": "string",
            "pattern": "^mutation-"
          }
        },
        "required": [
          "suite_id"
        ]
      },
      "then": {
        "required": [
          "survivors",
          "uncovered",
          "timeouts",
          "invalid",
          "missing",
          "killed",
          "scheduled",
          "mutants",
          "equivalent_exceptions"
        ],
        "properties": {
          "survivors": true,
          "uncovered": true,
          "timeouts": true,
          "invalid": true,
          "missing": true,
          "killed": true,
          "scheduled": true,
          "mutants": true,
          "equivalent_exceptions": true
        }
      }
    },
    {
      "if": {
        "properties": {
          "suite_id": {
            "const": "mutation-bounded"
          }
        },
        "required": [
          "suite_id"
        ]
      },
      "then": {
        "required": [
          "profile",
          "policy",
          "qualification",
          "exhaustive",
          "corpus_sha256",
          "per_language"
        ],
        "properties": {
          "profile": {
            "const": "bounded"
          },
          "policy": {
            "const": "bounded-reviewed-v1"
          },
          "qualification": {
            "const": "bounded-reviewed-corpus"
          },
          "exhaustive": {
            "const": false
          },
          "scheduled": {
            "const": 18
          },
          "killed": {
            "const": 18
          },
          "equivalent_exceptions": {
            "type": "array",
            "maxItems": 0
          },
          "per_language": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "scheduled",
                "killed"
              ],
              "properties": {
                "scheduled": {
                  "type": "integer",
                  "minimum": 0
                },
                "killed": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "required": [
              "typescript",
              "python",
              "rust",
              "perl"
            ],
            "properties": {
              "typescript": {
                "type": "object",
                "required": [
                  "scheduled",
                  "killed"
                ],
                "properties": {
                  "scheduled": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "killed": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "python": {
                "type": "object",
                "required": [
                  "scheduled",
                  "killed"
                ],
                "properties": {
                  "scheduled": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "killed": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "rust": {
                "type": "object",
                "required": [
                  "scheduled",
                  "killed"
                ],
                "properties": {
                  "scheduled": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "killed": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "perl": {
                "type": "object",
                "required": [
                  "scheduled",
                  "killed"
                ],
                "properties": {
                  "scheduled": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "killed": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "data": {
                "type": "object",
                "required": [
                  "scheduled",
                  "killed"
                ],
                "properties": {
                  "scheduled": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "killed": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "corpus_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "mutants": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "pattern": "^(?!/)[A-Za-z0-9._/-]+$"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "suite_id": {
              "const": "mutation-bounded"
            }
          },
          "required": [
            "suite_id"
          ]
        }
      },
      "then": {
        "properties": {
          "mutants": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "pattern": "^(packages|workers|scripts|runtime|quality|contracts|evals|\\.github)/"
                }
              }
            }
          }
        }
      }
    }
  ]
}
