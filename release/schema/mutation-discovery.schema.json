{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mehmetoguzderin/ud-agent-skill-mcp-plugin/schema/mutation-discovery-v1.json",
  "title": "Complete independent mutation backend discovery authority",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "qualification",
    "scope_complete",
    "input_sha256",
    "backend",
    "raw_generation",
    "inventory_sha256",
    "inventory",
    "execution",
    "sources",
    "generators",
    "configuration"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "mutation-backend-discovery"
    },
    "qualification": {
      "const": "complete-backend-inventory-no-outcomes"
    },
    "scope_complete": {
      "const": true
    },
    "input_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "backend": {
      "type": "object",
      "required": [
        "tool",
        "version"
      ],
      "properties": {
        "tool": {
          "enum": [
            "stryker",
            "mutmut",
            "python-static",
            "cargo-mutants",
            "ppi-perl",
            "fault-canary"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "raw_generation": {
      "$ref": "#/$defs/receipt"
    },
    "inventory_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "file",
          "source_sha256",
          "definition_sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "definition_sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "additionalProperties": false
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "command",
        "runtime"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "runtime": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "oci",
                "native"
              ]
            },
            "image_id": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "executable_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "version_receipt": {
              "$ref": "#/$defs/receipt"
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/receipt"
      }
    },
    "generators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/receipt"
      }
    },
    "configuration": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/receipt"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "receipt": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "size",
        "executable"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "executable": {
          "type": "boolean"
        }
      }
    }
  }
}
